# ==============================================================================
# Kite Code — Configuración de Variables de Entorno (.env.example)
# ==============================================================================
# Este archivo documenta todas las claves y variables de entorno soportadas por Kite.
# Para desarrollo local: copia este archivo a '.env' y completa tus valores.
# NOTA: Nunca subas tu archivo '.env' con claves reales a Git (.gitignore ya lo protege).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Proveedores de IA y Modelos (Backend Tauri / Monitores de Cuota)
# ------------------------------------------------------------------------------
# Claves utilizadas por el backend nativo (Rust) para monitoreo de cuotas y llamadas directas:
DEEPSEEK_API_KEY=
KIMI_API_KEY=
# MOONSHOT_API_KEY= # Alternativa a KIMI_API_KEY
GEMINI_API_KEY=

# Tokens de autenticación alternativa para CLI de Claude y OpenAI Codex:
CLAUDE_CODE_TOKEN=
# ANTHROPIC_OAUTH_TOKEN=
CODEX_ACCESS_TOKEN=
# CODEX_ACCOUNT_ID=

# Consola OpenCode Go (Monitoreo de cuotas y workspace):
OPENCODE_GO_AUTH_COOKIE=
OPENCODE_GO_WORKSPACE_ID=

# Ruta personalizada para Grok CLI (opcional, por defecto busca en ~/.grok):
# GROK_HOME=

# ------------------------------------------------------------------------------
# 2. Asistente Zed / Operator Gateway (Frontend Vite / Opciones por defecto)
# ------------------------------------------------------------------------------
# NOTA DE ARQUITECTURA:
# En la aplicación de escritorio, las claves ingresadas por el usuario en la pestaña
# de "Configuración > Asistente Zed" se persisten en el almacenamiento del usuario (localStorage).
# Puedes definir valores iniciales de desarrollo aquí si utilizas variables VITE_*:
VITE_OPENCODE_API_KEY=
VITE_OPENCODE_BASE_URL=https://opencode.ai/inference/v1

VITE_GROK_API_KEY=
VITE_GROK_BASE_URL=https://api.x.ai/v1

VITE_VERCEL_API_KEY=
VITE_VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1

VITE_CLOUDFLARE_ACCOUNT_ID=
VITE_CLOUDFLARE_API_TOKEN=
VITE_CLOUDFLARE_GATEWAY_SLUG=

# ------------------------------------------------------------------------------
# 3. Servidor Local y Despliegue (server/server.mjs & scripts)
# ------------------------------------------------------------------------------
PORT=1420
SERVE_DIR=dist
KITE_FEED_PORT=9101

# Actualizaciones locales de Kite (opcional):
# KITE_UPDATE_URL=http://localhost:9101/feed/latest.json

# Firma de versiones Tauri (usado en scripts de release):
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
