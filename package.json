{
  "name": "kite-code",
  "version": "0.1.26",
  "description": "Kite Code — Autonomous agentic development environment and native multi-model terminal desktop application",
  "main": "server/server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "vite",
    "dev:browser": "node scripts/dev-browser.mjs",
    "build": "tsc && vite build",
    "build:vite": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/launch-desktop-app.ps1",
    "build:installer": "tauri build",
    "build:installer:nsis": "tauri build --bundles nsis",
    "build:installer:msi": "tauri build --bundles msi",
    "update": "powershell -ExecutionPolicy Bypass -File ./update-and-launch.ps1",
    "rebuild-and-run": "npm run build:installer && npm run update",
    "release": "node scripts/release.mjs",
    "release:fast": "node scripts/release.mjs patch --fast",
    "release:dry": "node scripts/release.mjs patch --dry-run",
    "install:local": "powershell -ExecutionPolicy Bypass -File ./update-and-launch.ps1",
    "feed": "node scripts/feed-server.mjs --serve",
    "verify:operator:e2e": "vite-node scripts/verify-operator-e2e.ts",
    "verify:browser:smoke": "node scripts/browser-lane-smoke.mjs",
    "verify:browser:qa": "node scripts/qa/run-catalog.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.143",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "zod": "^4.6.7"
  }
}
